# ─── Copier ce fichier vers .env.local et renseigner les valeurs ─────────────
# cp .env.example .env.local

# ─── Database (Supabase / PostgreSQL) ────────────────────────────────────────
# ⚠️ Dans l'URL, un éventuel # dans le mot de passe se encode en %23
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL: port 5432, sans PgBouncer — nécessaire pour `prisma migrate deploy`
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── Prisma lit aussi .env (les valeurs y sont dupliquées) ───────────────────
# Si vous utilisez le transaction pooler, pointez DIRECT_URL vers le session pooler (5432).

# ─── Supabase API ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Générer un secret : `openssl rand -base64 32`
AUTH_SECRET=your-auth-secret
AUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Créer des identifiants sur https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Data provider (CFD / marché) ────────────────────────────────────────────
# Clé API Twelve Data : https://twelvedata.com
TWELVEDATA_API_KEY=your-twelvedata-api-key

# ─── Observabilité (Sentry) ─────────────────────────────────────────────────────
# Créer un projet sur https://sentry.io puis copier le DSN correspondant.
# SENTRY_DSN est lu côté serveur, NEXT_PUBLIC_SENTRY_DSN côté client.
SENTRY_DSN=https://xxx@sentry.io/projectId
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/projectId
# Token d'upload des source maps (garder secret, jamais commité)
SENTRY_AUTH_TOKEN=your-sentry-auth-token
