// TradeLink — Prisma Schema MVP
// 5 tables, pas une de plus

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USERS ──────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  timezone     String   @default("UTC")
  baseCurrency String   @default("USD") @map("base_currency")
  onboarded    Boolean  @default(false)
  dailyGoal    Decimal? @db.Decimal(15,2) @map("daily_goal")
  notificationPrefs Json? @map("notification_prefs")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts             TradingAccount[]
  behavioralSnapshots  BehavioralSnapshot[]
  propChallenges       PropChallenge[]
  setups               TradingSetup[]
  dailyJournals        DailyJournal[]

  @@map("users")
}

// ─── TRADING SETUPS ──────────────────────────────────────────────────────────
model TradingSetup {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("trading_setups")
}

// ─── TRADING ACCOUNTS ────────────────────────────────────────────────────────
model TradingAccount {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  name           String
  broker         String?
  type           String   @default("personal") // personal, demo, prop_firm
  baseCurrency   String   @default("USD") @map("base_currency")
  fxRateToUsd    Decimal  @default(1) @map("fx_rate_to_usd") @db.Decimal(15, 6)
  initialBalance Decimal? @map("initial_balance") @db.Decimal(15, 2)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades              Trade[]
  behavioralSnapshots BehavioralSnapshot[]
  propChallenge       PropChallenge?

  @@map("trading_accounts")
}

// ─── TRADES ──────────────────────────────────────────────────────────────────
model Trade {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accountId      String   @map("account_id")
  externalId     String?  @map("external_id") // broker trade ID — déduplication

  // Instrument
  symbol         String
  instrumentType String   @default("forex") @map("instrument_type") // forex | stock | crypto | futures | options | indices

  // Exécution
  side           String   // long | short
  quantity       Decimal  @db.Decimal(20, 8)
  entryPrice     Decimal  @map("entry_price") @db.Decimal(20, 8)
  exitPrice      Decimal? @map("exit_price") @db.Decimal(20, 8)
  entryAt        DateTime @map("entry_at")
  exitAt         DateTime? @map("exit_at")

  // P&L
  grossPnl       Decimal? @map("gross_pnl") @db.Decimal(15, 4)
  fees           Decimal  @default(0) @db.Decimal(15, 4)
  netPnl         Decimal? @map("net_pnl") @db.Decimal(15, 4)    // grossPnl - fees
  netPnlUsd      Decimal? @map("net_pnl_usd") @db.Decimal(15, 4) // converti en USD

  // Risk
  stopLoss       Decimal? @map("stop_loss") @db.Decimal(20, 8)
  riskAmount     Decimal? @map("risk_amount") @db.Decimal(15, 4)

  // Classification
  session        String?  // pre_market | ny_open | london | asia | overlap
  setupTags      String[] @map("setup_tags")
  emotionTags    String[] @map("emotion_tags")

  // Notes
  notesPost      String?  @map("notes_post")
  personalRating Int?     @map("personal_rating") // 1-5

  // Behavioral flags (computed)
  isRevengeTrade   Boolean @default(false) @map("is_revenge_trade")
  isOvertrading    Boolean @default(false) @map("is_overtrading")
  isStopViolated   Boolean @default(false) @map("is_stop_violated")

  // Meta
  status         String   @default("closed") // open | closed
  importSource   String   @default("manual") @map("import_source") // manual | csv | api
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account        TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  screenshots    TradeScreenshot[]

  @@unique([accountId, externalId]) // déduplication broker
  @@index([userId, entryAt(sort: Desc)])
  @@index([accountId])
  @@map("trades")
}

// ─── SCREENSHOTS ─────────────────────────────────────────────────────────────
model TradeScreenshot {
  id          String   @id @default(cuid())
  tradeId     String   @map("trade_id")
  storageUrl  String   @map("storage_url")
  fileName    String?  @map("file_name")
  createdAt   DateTime @default(now()) @map("created_at")

  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_screenshots")
}

// ─── BEHAVIORAL SNAPSHOTS ────────────────────────────────────────────────────
model BehavioralSnapshot {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  accountId       String   @map("account_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  disciplineScore Int      @map("discipline_score") // 0-100

  // [{type, count, impactPnl, tradeIds[]}]
  patterns        Json

  computedAt      DateTime @default(now()) @map("computed_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodStart, periodEnd])
  @@map("behavioral_snapshots")
}

// ─── PROP FIRM CHALLENGES ───────────────────────────────────────────────────

model PropFirmTemplate {
  id                    String   @id @default(cuid())
  firmName              String   @map("firm_name") // FTMO, Topstep, FundedNext...
  programName           String   @map("program_name") // "Normal", "Aggressive", "Swing"...
  logoUrl               String?  @map("logo_url") // logo de la firme
  drawdownType          String   @map("drawdown_type") // static_balance, trailing_balance, trailing_equity
  dailyDDPct            Decimal? @map("daily_dd_pct") @db.Decimal(5, 2)
  maxDDPct              Decimal  @map("max_dd_pct") @db.Decimal(5, 2)
  dailyResetTimezone    String   @default("UTC") @map("daily_reset_timezone")
  profitTargetPhase1Pct Decimal? @map("profit_target_phase1_pct") @db.Decimal(5, 2)
  profitTargetPhase2Pct Decimal? @map("profit_target_phase2_pct") @db.Decimal(5, 2)
  minTradingDays        Int?     @map("min_trading_days")
  maxTradingDays        Int?     @map("max_trading_days")
  consistencyRulePct    Decimal? @map("consistency_rule_pct") @db.Decimal(5, 2)
  weekendHoldingAllowed Boolean  @default(true) @map("weekend_holding_allowed")
  newsTradingAllowed    Boolean  @default(true) @map("news_trading_allowed")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  challenges            PropChallenge[]

  @@map("prop_firm_templates")
}

model PropChallenge {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  accountId        String   @unique @map("account_id") // 1:1 relation with TradingAccount
  templateId       String   @map("template_id")

  // Overrides
  initialBalance   Decimal  @map("initial_balance") @db.Decimal(15, 2)
  dailyDDPct       Decimal  @map("daily_dd_pct") @db.Decimal(5, 2)
  maxDDPct         Decimal  @map("max_dd_pct") @db.Decimal(5, 2)
  profitTargetPct  Decimal  @map("profit_target_pct") @db.Decimal(5, 2)
  minTradingDays   Int?     @map("min_trading_days")
  maxTradingDays   Int?     @map("max_trading_days")
  cost             Decimal? @map("cost") @db.Decimal(15, 2) // challenge cost / fees paid

  phase            String   @default("phase_1") // phase_1, phase_2, funded, failed
  status           String   @default("active")  // active, passed, failed, breached
  startedAt        DateTime @map("started_at")
  deadlineAt       DateTime? @map("deadline_at")
  breachedAt       DateTime? @map("breached_at")
  breachReason     String?  @map("breach_reason") // daily_dd, max_dd, consistency, time_limit
  metadata         Json?
  alertConfig      Json?    @map("alert_config") // { stopTradingPct, profitGoalPct, enableStopTrading, enableProfitGoal }

  // Live calculated values
  currentBalance   Decimal? @map("current_balance") @db.Decimal(15, 2)
  currentEquity    Decimal? @map("current_equity") @db.Decimal(15, 2)
  highestBalance   Decimal? @map("highest_balance") @db.Decimal(15, 2)
  highestEquity    Decimal? @map("highest_equity") @db.Decimal(15, 2)
  todayStartBalance Decimal? @map("today_start_balance") @db.Decimal(15, 2)
  todayResetAt     DateTime? @map("today_reset_at")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          TradingAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template         PropFirmTemplate   @relation(fields: [templateId], references: [id])
  
  dailySnapshots   PropChallengeDailySnapshot[]
  events           PropChallengeEvent[]
  payouts          PropPayout[]
  notes            PropChallengeNote[]

  @@map("prop_challenges")
}

model PropChallengeNote {
  id          String   @id @default(cuid())
  challengeId String   @map("challenge_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge    PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("prop_challenge_notes")
}

model PropChallengeDailySnapshot {
  id             String   @id @default(cuid())
  challengeId    String   @map("challenge_id")
  date           DateTime @db.Date // YYYY-MM-DD
  startBalance   Decimal  @map("start_balance") @db.Decimal(15, 2)
  endBalance     Decimal  @map("end_balance") @db.Decimal(15, 2)
  lowestEquity   Decimal  @map("lowest_equity") @db.Decimal(15, 2)
  dailyPnl       Decimal  @map("daily_pnl") @db.Decimal(15, 2)
  tradesCount    Int      @default(0) @map("trades_count")
  dailyDDUsedPct Decimal? @map("daily_dd_used_pct") @db.Decimal(5, 2)

  challenge      PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, date])
  @@map("prop_challenge_daily_snapshots")
}

model PropChallengeEvent {
  id           String   @id @default(cuid())
  challengeId  String   @map("challenge_id")
  eventType    String   @map("event_type") // alert_80pct, alert_90pct, phase_passed, breached, target_hit
  severity     String   @map("severity")   // info, warning, critical
  message      String?
  metadata     Json?
  readAt       DateTime? @map("read_at")
  createdAt    DateTime @default(now()) @map("created_at")

  challenge    PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("prop_challenge_events")
}

model PropPayout {
  id          String   @id @default(cuid())
  challengeId String   @map("challenge_id")
  amount      Decimal  @db.Decimal(15, 2)
  status      String   @default("requested") // requested, approved, paid, rejected
  requestedAt DateTime @default(now()) @map("requested_at")
  note        String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge   PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("prop_payouts")
}

// ─── DAILY JOURNAL ───────────────────────────────────────────────────────────
model DailyJournal {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  date            String   // Format: YYYY-MM-DD
  mood            String?
  macroContext    String?  @db.Text
  sessionPlan     String?  @db.Text
  endOfDaySummary String?  @db.Text
  rating          Int?     // 1 to 5 stars
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_journals")
}
