// TradeLink — Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── USERS ──────────────────────────────────────────────────────────────────
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String?     @map("password_hash")
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  deletedAt    DateTime?   @map("deleted_at")
  timezone     String      @default("UTC")
  baseCurrency String      @default("USD") @map("base_currency")
  onboarded    Boolean     @default(false)
  tokenVersion Int         @default(0) @map("token_version")
  lastLoginAt  DateTime?   @map("last_login_at")
  dailyGoal    Decimal?    @db.Decimal(15,2) @map("daily_goal")
  monthlyGoal  Decimal?    @db.Decimal(15,2) @map("monthly_goal")
  notificationPrefs Json?  @map("notification_prefs")
  riskPrefs        Json?   @map("risk_prefs")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts             TradingAccount[]
  oauthAccounts        Account[]
  sessions             Session[]
  behavioralSnapshots  BehavioralSnapshot[]
  propChallenges       PropChallenge[]
  setups               TradingSetup[]
  dailyJournals        DailyJournal[]
  achievements         UserAchievement[]
  backtestSessions     BacktestSession[]
  watchlist            WatchlistItem[]
  subscriptions        Subscription[]
  adminActionLogs      AdminActionLog[]     @relation("AdminUser")
  targetedActionLogs   AdminActionLog[]     @relation("TargetUser")
  ownedTickets         SupportTicket[]      @relation("TicketUser")
  assignedTickets      SupportTicket[]      @relation("TicketAssignedAdmin")
  supportMessages      SupportMessage[]
  shareLinks           ShareLink[]

  @@map("users")
}

// ─── NEXTAUTH OAUTH ──────────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── TRADING SETUPS ──────────────────────────────────────────────────────────
model TradingSetup {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("trading_setups")
}

// ─── TRADING ACCOUNTS ────────────────────────────────────────────────────────
model TradingAccount {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  name           String
  broker         String?
  type           String   @default("personal") // personal, demo, prop_firm
  baseCurrency   String   @default("USD") @map("base_currency")
  fxRateToUsd    Decimal  @default(1) @map("fx_rate_to_usd") @db.Decimal(15, 6)
  initialBalance Decimal? @map("initial_balance") @db.Decimal(15, 2)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades              Trade[]
  behavioralSnapshots BehavioralSnapshot[]
  propChallenge       PropChallenge?

  @@map("trading_accounts")
}

// ─── TRADES ──────────────────────────────────────────────────────────────────
model Trade {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accountId      String   @map("account_id")
  externalId     String?  @map("external_id") // broker trade ID — déduplication

  // Instrument
  symbol         String
  instrumentType String   @default("forex") @map("instrument_type") // forex | stock | crypto | futures | options | indices

  // Exécution
  side           String   // long | short
  quantity       Decimal  @db.Decimal(20, 8)
  entryPrice     Decimal  @map("entry_price") @db.Decimal(20, 8)
  exitPrice      Decimal? @map("exit_price") @db.Decimal(20, 8)
  entryAt        DateTime @map("entry_at")
  exitAt         DateTime? @map("exit_at")

  // P&L
  grossPnl       Decimal? @map("gross_pnl") @db.Decimal(15, 4)
  fees           Decimal  @default(0) @db.Decimal(15, 4)
  netPnl         Decimal? @map("net_pnl") @db.Decimal(15, 4)    // grossPnl - fees
  netPnlUsd      Decimal? @map("net_pnl_usd") @db.Decimal(15, 4) // converti en USD

  // Risk
  stopLoss       Decimal? @map("stop_loss") @db.Decimal(20, 8)
  riskAmount     Decimal? @map("risk_amount") @db.Decimal(15, 4)

  // Classification
  session        String?  // pre_market | ny_open | london | asia | overlap
  setupTags      String[] @map("setup_tags")
  emotionTags    String[] @map("emotion_tags")

  // Notes
  notesPost      String?  @map("notes_post")
  personalRating Int?     @map("personal_rating") // 1-5

  // Behavioral flags (computed)
  isRevengeTrade   Boolean @default(false) @map("is_revenge_trade")
  isOvertrading    Boolean @default(false) @map("is_overtrading")
  isStopViolated   Boolean @default(false) @map("is_stop_violated")

  // Meta
  status         String   @default("closed") // open | closed
  importSource   String   @default("manual") @map("import_source") // manual | csv | api | backtest
  source         String   @default("live") // live | backtest — permet d'exclure les trades de backtest des stats réelles
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account        TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  screenshots    TradeScreenshot[]
  backtestSession BacktestSession? @relation(fields: [backtestSessionId], references: [id], onDelete: Cascade)
  backtestSessionId String? @map("backtest_session_id")

  @@unique([accountId, externalId]) // déduplication broker
  @@index([userId, entryAt(sort: Desc)])
  @@index([userId, status])
  @@index([accountId, status, exitAt(sort: Asc)])
  @@index([accountId])
  @@index([backtestSessionId])
  @@index([status])
  @@map("trades")
}

// ─── SCREENSHOTS ─────────────────────────────────────────────────────────────
model TradeScreenshot {
  id          String   @id @default(cuid())
  tradeId     String   @map("trade_id")
  storageUrl  String   @map("storage_url")
  fileName    String?  @map("file_name")
  createdAt   DateTime @default(now()) @map("created_at")

  trade       Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_screenshots")
}

// ─── BEHAVIORAL SNAPSHOTS ────────────────────────────────────────────────────
model BehavioralSnapshot {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  accountId       String   @map("account_id")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  disciplineScore Int      @map("discipline_score") // 0-100

  // [{type, count, impactPnl, tradeIds[]}]
  patterns        Json

  computedAt      DateTime @default(now()) @map("computed_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodStart, periodEnd])
  @@map("behavioral_snapshots")
}

// ─── PROP FIRM CHALLENGES ───────────────────────────────────────────────────

model PropFirmTemplate {
  id                    String   @id @default(cuid())
  firmName              String   @map("firm_name") // FTMO, Topstep, FundedNext...
  programName           String   @map("program_name") // "Normal", "Aggressive", "Swing"...
  logoUrl               String?  @map("logo_url") // logo de la firme
  drawdownType          String   @map("drawdown_type") // static_balance, trailing_balance, trailing_equity
  dailyDDPct            Decimal? @map("daily_dd_pct") @db.Decimal(5, 2)
  maxDDPct              Decimal  @map("max_dd_pct") @db.Decimal(5, 2)
  dailyResetTimezone    String   @default("UTC") @map("daily_reset_timezone")
  profitTargetPhase1Pct Decimal? @map("profit_target_phase1_pct") @db.Decimal(5, 2)
  profitTargetPhase2Pct Decimal? @map("profit_target_phase2_pct") @db.Decimal(5, 2)
  minTradingDays        Int?     @map("min_trading_days")
  maxTradingDays        Int?     @map("max_trading_days")
  consistencyRulePct    Decimal? @map("consistency_rule_pct") @db.Decimal(5, 2)
  weekendHoldingAllowed Boolean  @default(true) @map("weekend_holding_allowed")
  newsTradingAllowed    Boolean  @default(true) @map("news_trading_allowed")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  challenges            PropChallenge[]

  @@map("prop_firm_templates")
}

model PropChallenge {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  accountId        String   @unique @map("account_id") // 1:1 relation with TradingAccount
  templateId       String   @map("template_id")

  // Overrides
  initialBalance   Decimal  @map("initial_balance") @db.Decimal(15, 2)
  dailyDDPct       Decimal  @map("daily_dd_pct") @db.Decimal(5, 2)
  maxDDPct         Decimal  @map("max_dd_pct") @db.Decimal(5, 2)
  profitTargetPct  Decimal  @map("profit_target_pct") @db.Decimal(5, 2)
  minTradingDays   Int?     @map("min_trading_days")
  maxTradingDays   Int?     @map("max_trading_days")
  cost             Decimal? @map("cost") @db.Decimal(15, 2) // challenge cost / fees paid

  phase            String   @default("phase_1") // phase_1, phase_2, funded, failed
  status           String   @default("active")  // active, passed, failed, breached
  startedAt        DateTime @map("started_at")
  deadlineAt       DateTime? @map("deadline_at")
  breachedAt       DateTime? @map("breached_at")
  breachReason     String?  @map("breach_reason") // daily_dd, max_dd, consistency, time_limit
  metadata         Json?
  alertConfig      Json?    @map("alert_config") // { stopTradingPct, profitGoalPct, enableStopTrading, enableProfitGoal }

  // Live calculated values
  currentBalance   Decimal? @map("current_balance") @db.Decimal(15, 2)
  currentEquity    Decimal? @map("current_equity") @db.Decimal(15, 2)
  highestBalance   Decimal? @map("highest_balance") @db.Decimal(15, 2)
  highestEquity    Decimal? @map("highest_equity") @db.Decimal(15, 2)
  todayStartBalance Decimal? @map("today_start_balance") @db.Decimal(15, 2)
  todayResetAt     DateTime? @map("today_reset_at")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          TradingAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template         PropFirmTemplate   @relation(fields: [templateId], references: [id])
  
  dailySnapshots   PropChallengeDailySnapshot[]
  events           PropChallengeEvent[]
  payouts          PropPayout[]
  notes            PropChallengeNote[]

  @@index([userId])
  @@map("prop_challenges")
}

model PropChallengeNote {
  id          String   @id @default(cuid())
  challengeId String   @map("challenge_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge    PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("prop_challenge_notes")
}

model PropChallengeDailySnapshot {
  id             String   @id @default(cuid())
  challengeId    String   @map("challenge_id")
  date           DateTime @db.Date // YYYY-MM-DD
  startBalance   Decimal  @map("start_balance") @db.Decimal(15, 2)
  endBalance     Decimal  @map("end_balance") @db.Decimal(15, 2)
  lowestEquity   Decimal  @map("lowest_equity") @db.Decimal(15, 2)
  dailyPnl       Decimal  @map("daily_pnl") @db.Decimal(15, 2)
  tradesCount    Int      @default(0) @map("trades_count")
  dailyDDUsedPct Decimal? @map("daily_dd_used_pct") @db.Decimal(5, 2)

  challenge      PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, date])
  @@map("prop_challenge_daily_snapshots")
}

model PropChallengeEvent {
  id           String   @id @default(cuid())
  challengeId  String   @map("challenge_id")
  eventType    String   @map("event_type") // alert_80pct, alert_90pct, phase_passed, breached, target_hit
  severity     String   @map("severity")   // info, warning, critical
  message      String?
  metadata     Json?
  readAt       DateTime? @map("read_at")
  createdAt    DateTime @default(now()) @map("created_at")

  challenge    PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([challengeId, eventType])
  @@map("prop_challenge_events")
}

model PropPayout {
  id          String   @id @default(cuid())
  challengeId String   @map("challenge_id")
  amount      Decimal  @db.Decimal(15, 2)
  status      String   @default("requested") // requested, approved, paid, rejected
  requestedAt DateTime @default(now()) @map("requested_at")
  note        String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge   PropChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("prop_payouts")
}

// ─── DAILY JOURNAL ───────────────────────────────────────────────────────────
model DailyJournal {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  date            String   // Format: YYYY-MM-DD
  mood            String?
  macroContext    String?  @db.Text
  sessionPlan     String?  @db.Text
  endOfDaySummary String?  @db.Text
  rating          Int?     // 1 to 5 stars
  sleepHours      Int?     @map("sleep_hours")
  disciplineChecks Json?   @map("discipline_checks")
  nightReflection String?  @db.Text @map("night_reflection")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_journals")
}

// ─── WATCHLIST ────────────────────────────────────────────────────────────────
model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  symbol      String
  displayName String?  @map("display_name")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, sortOrder])
  @@map("watchlist_items")
}

// ─── BACKTEST SESSIONS ───────────────────────────────────────────────────────
model BacktestSession {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  symbol        String
  timeframe     String // 1m, 5m, 15m, 1h, 4h, 1D
  from          DateTime
  to            DateTime
  strategyName  String?  @map("strategy_name")
  initialBalance Decimal @default(10000) @map("initial_balance") @db.Decimal(15, 2)
  closedPnl     Decimal? @map("closed_pnl") @db.Decimal(15, 4)
  winRate       Decimal? @map("win_rate") @db.Decimal(5, 2)
  tradesCount   Int      @default(0) @map("trades_count")
  totalR        Decimal? @map("total_r") @db.Decimal(10, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades        Trade[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("backtest_sessions")
}

// ─── ACHIEVEMENTS ────────────────────────────────────────────────────────────
model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  category    String   @default("general") // general, consistency, prop, journal, skill
  target      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  unlocks     UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ─── PLANS & SUBSCRIPTIONS ──────────────────────────────────────────────────
model Plan {
  id                String  @id @default(cuid())
  name              String  @unique
  price             Decimal @db.Decimal(10, 2)
  maxAccounts       Int     @default(1) @map("max_accounts")
  backtestAccess    Boolean @default(false) @map("backtest_access")
  maxTradesPerMonth Int?    @map("max_trades_per_month")
  isActive          Boolean @default(true) @map("is_active")
  features          Json?   @default("{}") // Store arbitrary features like {"replayAccess": true}
  createdAt         DateTime @default(now()) @map("created_at")

  subscriptions     Subscription[]

  @@map("plans")
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  planId        String             @map("plan_id")
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now()) @map("start_date")
  renewalDate   DateTime?          @map("renewal_date")
  canceledAt    DateTime?          @map("canceled_at")
  cryptoTxId    String?            @map("crypto_tx_id") // Hash of the crypto payment
  cryptoAddress String?            @map("crypto_address") // Address paid to
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan               @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("subscriptions")
}

// ─── ADMIN ACTION LOGS ──────────────────────────────────────────────────────
model AdminActionLog {
  id           String   @id @default(cuid())
  adminId      String   @map("admin_id")
  targetUserId String?  @map("target_user_id")
  action       String   // ROLE_CHANGED, USER_SUSPENDED, USER_BANNED, USER_DELETED, PLAN_CHANGED, IMPERSONATION_STARTED, etc.
  reason       String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  admin        User     @relation("AdminUser", fields: [adminId], references: [id])
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_action_logs")
}

// ─── SUPPORT TICKETS ────────────────────────────────────────────────────────
model SupportTicket {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  subject         String
  status          TicketStatus @default(OPEN)
  priority        String       @default("normal") // low, normal, high, urgent
  assignedAdminId String?      @map("assigned_admin_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user            User         @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin   User?        @relation("TicketAssignedAdmin", fields: [assignedAdminId], references: [id])
  messages        SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

// ─── SHARE LINKS ────────────────────────────────────────────────────────────
model ShareLink {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type") // e.g. "challenge", "trade", "stats"
  entityId   String   @map("entity_id")
  isPublic   Boolean  @default(true) @map("is_public")
  views      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("share_links")
}

